{
  "name": "zvon",
  "productName": "Zvon",
  "version": "1.1.0",
  "description": "Голос, демонстрация экрана и чат для друзей в локальной или виртуальной сети",
  "main": "out/main/index.js",
  "author": {
    "name": "Zvon",
    "email": "zvon@localhost"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:web",
    "build:web": "vite build -c vite.web.config.ts",
    "start": "electron-vite preview",
    "app": "electron .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:server": "npm run build && node scripts/smoke-test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "mediasoup": "^3.14.0",
    "node-forge": "^1.3.1",
    "uiohook-napi": "^1.5.4",
    "web-push": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@jitsi/rnnoise-wasm": "^0.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.15.0",
    "@types/node-forge": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "i18next": "^25.0.0",
    "mediasoup-client": "^3.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
